<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>bridge-designer</AssemblyName>
    <RootNamespace>BridgeDesigner</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The mod's own reader and the glb exporter (tools/assets), so the designer sees what the game has. -->
    <Compile Include="../../src/AssetFile.cs" />
    <Compile Include="../assets/Export.cs" />
    <!-- The page, served from beside the program. -->
    <None Include="web/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
