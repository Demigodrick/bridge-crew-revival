<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Star Trek Bridge Crew</GameDir>
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0022;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game's own Photon client library (not shipped). -->
    <Reference Include="Photon3Unity3D" HintPath="$(GameDir)/stbc_Data/Managed/Photon3Unity3D.dll" />
  </ItemGroup>
</Project>
