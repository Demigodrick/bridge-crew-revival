<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The real Photon client from the game, used to test the server against the exact library the game ships. -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Star Trek Bridge Crew</GameDir>
    <PhotonClientDll>$(GameDir)/stbc_Data/Managed/Photon3Unity3D.dll</PhotonClientDll>
    <DefineConstants Condition="Exists('$(PhotonClientDll)')">$(DefineConstants);HAS_PHOTON_CLIENT</DefineConstants>
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0022;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PhotonClientDll)')">
    <Reference Include="Photon3Unity3D" HintPath="$(PhotonClientDll)" />
    <!-- The mod's Photon socket hook, tested here against the real client. -->
    <Compile Include="../../shared/VirtualSockets.cs" Link="Shared/VirtualSockets.cs" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StbcServer\StbcServer.csproj" />
    <ProjectReference Include="..\StbcCore\StbcCore.csproj" />
  </ItemGroup>

</Project>
